# Core Platform Infrastructure
DATABASE_URL="postgresql://user:password@host:port/database"
REDIS_URL="redis://host:port"

# Cloudflare Edge Security & Tunnel
CLOUDFLARE_TUNNEL_TOKEN="your-cloudflare-tunnel-token"
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"

# Stripe-Consolidated Financial & Treasury Services
# Note: Mercury Banking has been replaced; all cash, card issuing, and treasury flows are managed via Stripe.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_TREASURY_ACCOUNT_ID="fi_..."  # ECOS Stripe Treasury Financial Account
STRIPE_ISSUING_CARD_HOLDER_ID="ich_..." # Used to generate programmatic distributor single-use virtual cards

# Communication Services
TELNYX_KEY="your-telnyx-key"

# Add other service keys as domains are built out
# e.g., SUPPLIER_X_API_KEY=...
