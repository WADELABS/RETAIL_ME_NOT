{
  "name": "ecos-monorepo",
  "private": true,
  "scripts": {
    "test": "pnpm -r test",
    "test:contracts": "node --import tsx --test tests/contracts/*.test.ts",
    "test:simulation": "node --import tsx --test tests/e2e-order-simulation.test.ts",
    "test:ingestion": "node --import tsx --test services/catalog-ingestion/tests/*.test.ts",
    "test:optimization": "node --import tsx --test services/pricing-engine/tests/*.test.ts",
    "test:learning": "node --import tsx --test tests/e2e-learning-simulation.test.ts",
    "test:telemetry": "node --import tsx --test tests/e2e-telemetry-surge-pricing.test.ts",
    "test:orders": "node --import tsx --test services/orders/tests/*.test.ts",
    "test:billing": "node --import tsx --test tests/e2e-billing-telemetry.test.ts",
    "test:privacy": "node --import tsx --test services/telemetry-intelligence/tests/*.test.ts",
    "test:identity": "node --import tsx --test services/identity/tests/*.test.ts",
    "test:risk": "node --import tsx --test services/risk/tests/*.test.ts",
    "test:rules": "node --import tsx --test services/decision-engine/tests/*.test.ts",
    "test:inventory": "node --import tsx --test services/inventory-availability/tests/*.test.ts",
    "test:communication": "node --import tsx --test services/communication/tests/*.test.ts",
    "test:accounting": "node --import tsx --test services/accounting/tests/*.test.ts",
    "test:procurement": "node --import tsx --test services/procurement/tests/*.test.ts",
    "lint": "eslint . --ext .ts"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/platform-core/",
      "/services/",
      "/tests/"
    ]
  },
  "dependencies": {
    "wrangler": "^4.114.0"
